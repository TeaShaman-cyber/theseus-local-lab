// Theseus host monitoring — Grafana Alloy config (READY TO DEPLOY).
// Endpoint and instance ID are already filled. Only the token is missing:
// replace <PASTE_TOKEN_HERE> with the access-policy token from policy
// "stack-1891821-alloy" (scope set:alloy-data-write), then copy this file to
// C:\Program Files\GrafanaLabs\Alloy\config.alloy and restart the Alloy service.

logging {
  level = "info"
}

prometheus.exporter.windows "host" {
  enabled_collectors = [
    "cpu",
    "logical_disk",
    "memory",
    "net",
    "os",
    "system",
    "process",
    "thermalzone",
  ]

  process {
    include = "^(Hermes|python|pythonw|node|Code|chrome|msedge|opera|Docker Desktop|com.docker.backend|com.docker.build|vmmem|vmmemWSL|powershell|pwsh|alloy|svchost)$"
    exclude = "^$"
  }
}

discovery.relabel "host" {
  targets = prometheus.exporter.windows.host.targets

  rule {
    action = "labeldrop"
    regex  = "process_id"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "30s"
}

// Latency probes. Both paths go through the active VPN, so the measured
// round-trip is the real user-visible path, not a clean-link baseline.
prometheus.exporter.blackbox "probes" {
  config_file = "C:/Program Files/GrafanaLabs/Alloy/blackbox.yml"

  target {
    name    = "internet_icmp"
    address = "1.1.1.1"
    module  = "icmp"
    labels  = { target_name = "1.1.1.1" }
  }

  target {
    name    = "grafana_https"
    address = "https://grafana.com"
    module  = "https"
    labels  = { target_name = "grafana.com" }
  }
}

prometheus.scrape "probes" {
  targets         = prometheus.exporter.blackbox.probes.targets
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "30s"
}

// Hardware sensors from OhmGraphite + LibreHardwareMonitor, which reads MSR
// through the PawnIO driver. This is the only source of REAL core clock and
// per-core temperature — windows_exporter reports a static nominal frequency.
prometheus.scrape "ohmgraphite" {
  targets         = [{ __address__ = "127.0.0.1:4445", job = "ohmgraphite" }]
  metrics_path    = "/metrics/"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "30s"
}

// Hermes technical logs plus agent.log. Operator decision 2026-10-25: the
// destination is the operator's own private Grafana Cloud stack, so agent.log is
// included. Known residual risk: stray secrets inside log lines would travel
// with them — acceptable to the owner, recorded here on purpose.
local.file_match "hermes_logs" {
  path_targets = [
    { __path__ = "C:/Users/s.poklad/AppData/Local/hermes/logs/errors.log",  job = "hermes", log_type = "errors" },
    { __path__ = "C:/Users/s.poklad/AppData/Local/hermes/logs/gateway.log", job = "hermes", log_type = "gateway" },
    { __path__ = "C:/Users/s.poklad/AppData/Local/hermes/logs/agent.log",   job = "hermes", log_type = "agent" },
  ]
}

loki.source.file "hermes_logs" {
  targets    = local.file_match.hermes_logs.targets
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = "https://<LOKI_HOST>/loki/api/v1/push"

    basic_auth {
      username = "<LOKI_USER_ID>"
      password = "<PASTE_TOKEN_HERE>"
    }
  }

  external_labels = {
    host = "theseus-laptop",
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "https://<PROMETHEUS_HOST>/api/prom/push"

    basic_auth {
      username = "<GRAFANA_INSTANCE_ID>"
      password = "<PASTE_TOKEN_HERE>"
    }

    // Drop the per-instance PID label before the series leave the host.
    // Without this, every process restart mints a new series and the free
    // tier's 10k active-series budget drains over the 14-day window.
    write_relabel_config {
      action = "labeldrop"
      regex  = "process_id"
    }
  }

  external_labels = {
    host = "theseus-laptop",
  }
}
