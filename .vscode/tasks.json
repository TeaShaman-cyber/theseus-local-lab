      },
      "problemMatcher": []
    },
    {
      "label": "Theseus: ask Bothub council advisor",
      "type": "shell",
      "command": ".\\tools\\infisical_cli\\node_modules\\@infisical\\cli\\bin\\infisical.exe run --env=local --path=/providers -- pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\bothub-council.ps1 -Prompt \"${input:bothubCouncilPrompt}\" -Models gpt-4o-mini -ChairmanModel gpt-4o-mini -MaxTokens 700 -SkipPeerReview -Quiet",
