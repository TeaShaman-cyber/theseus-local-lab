        "vscode",
        "wsl",
        "other"
      ],
      "default": "vscode"
    },
    {
      "id": "theseusVmHost",
      "type": "promptString",
      "description": "Theseus Ubuntu VM SSH host",
      "default": "192.168.121.130"
    },
    {
      "id": "theseusVmUser",
      "type": "promptString",
      "description": "Theseus Ubuntu VM SSH user",
      "default": "sysadmin"
    },
    {
      "id": "theseusVmKey",
      "type": "promptString",
      "description": "Optional SSH private key path for the Theseus Ubuntu VM",
