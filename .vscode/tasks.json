      "type": "promptString",
      "description": "Commit message for the current checkpoint",
      "default": "Add VS Code MCP and AHP bridge"
    },
    {
      "id": "bothubCouncilPrompt",
      "type": "promptString",
      "description": "Safe, explicit prompt for Bothub council advisor"
    },
    {
      "id": "sessionJournalNote",
      "type": "promptString",
      "description": "Short observable note for the lab journal"
    },
    {
      "id": "memoryHookSummary",
      "type": "promptString",
      "description": "Short compact/checkpoint summary"
    },
    {
      "id": "memoryHookGoal",
      "type": "promptString",
      "description": "Current goal for the compact packet"
    },
    {
      "id": "memoryHookOpenLoop",
      "type": "promptString",
      "description": "One open loop to preserve"
    },
    {
      "id": "researchQueueTopic",
      "type": "promptString",
      "description": "Public research topic to queue"
    },
    {
      "id": "researchQueueWhy",
      "type": "promptString",
      "description": "Why this topic should be checked"
    },
    {
