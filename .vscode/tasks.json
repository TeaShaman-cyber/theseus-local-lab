{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Theseus: git status",
      "type": "shell",
      "command": "git status --short",
      "problemMatcher": []
    },
    {
      "label": "Theseus: lint markdown",
      "type": "shell",
      "command": "npm exec --yes markdownlint-cli2",
      "problemMatcher": []
    },
    {
      "label": "Theseus: lint scripts",
      "type": "shell",
      "command": "$ErrorActionPreference='Stop'; Get-ChildItem -Recurse -Filter *.ps1 | ForEach-Object { $tokens=$null; $errors=$null; [System.Management.Automation.PSParser]::Tokenize((Get-Content -LiteralPath $_.FullName -Raw), [ref]$errors) | Out-Null; if ($errors.Count -gt 0) { Write-Output $_.FullName; $errors | ForEach-Object { Write-Output $_ }; exit 1 } }",
      "problemMatcher": []
    },
    {
      "label": "Theseus: ask Copilot advisor",
      "type": "shell",
      "command": "node tools/copilot_advisor/copilot_advisor.mjs \"${input:copilotAdvisorPrompt}\"",
      "options": {
        "env": {
          "COPILOT_ADVISOR_PROXY": "http://127.0.0.1:10808"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Theseus: AutoMem status",
      "type": "shell",
      "command": ".\\scripts\\automem-status.ps1",
      "problemMatcher": []
    },
    {
      "label": "Theseus: Observatory status",
      "type": "shell",
      "command": ".\\scripts\\stateful-agent-net-status.ps1 -Tail 40",
      "problemMatcher": []
    },
    {
      "label": "Theseus: Backup runner status",
      "type": "shell",
      "command": "docker compose -f .\\backup-lattice\\docker-compose.yml ps; docker compose -f .\\backup-lattice\\docker-compose.yml logs --tail=40 backup-runner",
      "problemMatcher": []
    },
    {
      "label": "Theseus: Export CodeWhale context",
      "type": "shell",
      "command": ".\\scripts\\agent-shell.ps1 -Command \"python3 tools/memory_context/export_context.py\"",
      "problemMatcher": []
    },
    {
      "label": "Theseus: Create data backup now",
      "type": "shell",
      "command": ".\\scripts\\agent-shell.ps1 -Command \"python3 tools/backup_lattice/backup_lattice.py once --mirror-dir /workspace/../theseus-cloud-backups\"",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "copilotAdvisorPrompt",
      "type": "promptString",
      "description": "Safe, explicit prompt for Copilot advisor"
    }
  ]
}
