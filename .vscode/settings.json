{
  "files.exclude": {
    "**/.codewhale-home": true,
    "**/.git": true,
    "**/.local_secrets": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true,
    "**/backups": true,
    "**/node_modules": true,
    "**/tmp": true,
    "**/work": true
  },
  "search.exclude": {
    "**/.codewhale-home": true,
    "**/.local_secrets": true,
    "**/backups": true,
    "**/node_modules": true,
    "**/outputs/context/*.md": true,
    "**/outputs/memory_inbox/*.md": true,
    "**/outputs/state_packets/*.md": true,
    "**/stateful-agent-net/data": true,
    "**/tmp": true,
    "**/work": true
  },
  "files.watcherExclude": {
    "**/.codewhale-home/**": true,
    "**/.local_secrets/**": true,
    "**/backups/**": true,
    "**/node_modules/**": true,
    "**/outputs/context/**": true,
    "**/outputs/memory_inbox/**": true,
    "**/outputs/state_packets/**": true,
    "**/stateful-agent-net/data/**": true,
    "**/tmp/**": true,
    "**/work/**": true
  },
  "markdown.preview.openMarkdownLinks": "inPreview",
  "cSpell.language": "en,ru",
  "cSpell.enabledLanguageIds": [
    "markdown",
    "plaintext",
    "powershell",
    "python",
    "shellscript",
    "yaml",
    "json"
  ],
  "cSpell.words": [
    "AGILE",
    "Airtable",
    "AutoMem",
    "Bothub",
    "ButlerBrain",
    "CodeWhale",
    "Codex",
    "DeepSeek",
    "DriveFS",
    "FalkorDB",
    "GitLens",
    "MobaXterm",
    "Qdrant",
    "RemoteSSH",
    "Theseus",
    "VMware",
    "agentic",
    "automem",
    "backup",
    "backups",
    "bothub",
    "codewhale",
    "exocortex",
    "harness",
    "kanban",
    "mechanobiology",
    "metamemory",
    "observatory",
    "stateful",
    "vmrun"
  ],
  "markdownlint.config": {
    "MD013": false,
    "MD033": false,
    "MD041": false
  },
  "shellcheck.enable": true,
  "remote.SSH.remotePlatform": {
    "theseus-ubuntu-vm": "linux"
  },
  "remote.SSH.showLoginTerminal": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell"
}
